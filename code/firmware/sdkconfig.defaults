# Medusa Wi-Fi internals lab defaults. Keep capture metadata-only and the
# console usable on the common ESP32/ESP32-S3 development boards.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_MEDUSA_LAB_CHANNEL=1
CONFIG_MEDUSA_LAB_COUNTRY_CODE="PT"
